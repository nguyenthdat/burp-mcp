{
  "name": "@nguyenthdat/burpmcp",
  "version": "2.0.0",
  "packageManager": "bun@1.3.14",
  "description": "Burp Suite MCP server with 80+ tools for authorized web security testing",
  "license": "MIT",
  "author": {
    "name": "Dat Nguyen",
    "email": "dat.nguyen@bitbytelab.io",
    "url": "https://www.bitbytelab.io"
  },
  "keywords": [
    "application-security",
    "burp",
    "burp-suite",
    "cybersecurity",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "penetration-testing",
    "security",
    "security-testing",
    "vulnerability-scanner",
    "web-security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenthdat/burp-mcp.git"
  },
  "homepage": "https://github.com/nguyenthdat/burp-mcp#readme",
  "bugs": {
    "url": "https://github.com/nguyenthdat/burp-mcp/issues"
  },
  "bin": {
    "burpmcp": "bridge/src/main.ts"
  },
  "files": [
    "bridge/src",
    "README.md",
    "DISCLOSURE",
    "LICENSE"
  ],
  "contentPolicy": {
    "class": "dual-use"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=18.19.0 <19 || >=20.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck",
    "lint": "biome check bridge/src bridge/test",
    "test:bridge": "node --test test/*.test.js",
    "test:unit": "bun test bridge/test",
    "test": "bun run test:bridge && bun run test:unit",
    "check": "bun run lint && bun run build && bun run test",
    "prepack": "bun run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "cyberchef-node": "3.0.1",
    "zod": "^4.1.12"
  }
}
