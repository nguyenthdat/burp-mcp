{
  "name": "burp-mcp-bridge",
  "version": "2.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "bun build ./bridge/src/main.ts --target=node --format=cjs --outfile=./mcp-bridge.js",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && bun run bundle",
    "lint": "biome check bridge/src bridge/test",
    "test:bridge": "node --test test/*.test.js",
    "test:unit": "bun test bridge/test",
    "test": "bun run build && bun run test:bridge && bun run test:unit",
    "check": "bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
