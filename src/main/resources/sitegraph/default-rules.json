{
  "id": "burp-mcp-default-exact",
  "version": "2026.08.1",
  "max_matches": 128,
  "rules": [
    {
      "id": "secret_like_value",
      "pattern": "(?i)(?:token|secret|api[_-]?key|authorization|cookie)\\s*[:=]\\s*([^\\s&\\\"']+)",
      "capture_group": 1,
      "severity": "high",
      "surfaces": [
        "request_message",
        "response_message",
        "response_body",
        "websocket_payload",
        "websocket_edited_payload"
      ]
    },
    {
      "id": "jwt",
      "pattern": "eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}",
      "capture_group": 0,
      "severity": "high",
      "surfaces": [
        "request_message",
        "response_message",
        "response_body",
        "websocket_payload",
        "websocket_edited_payload"
      ]
    }
  ]
}
