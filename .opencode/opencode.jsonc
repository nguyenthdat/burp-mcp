{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/instructions/rust-module-structure.md"],
  "plugin": ["oh-my-openagent@latest"],
  "mcp": {
    "macos": {
      "type": "local",
      "command": ["macos-mcp", "serve", "--transport", "stdio"],
      "enabled": true,
      "environment": { "ANONYMIZED_TELEMETRY": "false" },
    },
    "javadoc": { "type": "local", "command": ["bunx", "-y", "javadoc-mcp"], "enabled": true },
  },
}
